# Copie ce fichier en .env et remplis les vraies valeurs.
# .env est exclu du dépôt via .gitignore (jamais commité).

# --- Connexion à la base de test locale (représente la bd_bank en dev) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bd_bank_test
DB_USER=bdbank_readonly
DB_PASSWORD=change_me

# Mot de passe root utilisé uniquement par le conteneur Docker local
# (jamais utilisé par l'application elle-même)
DB_ROOT_PASSWORD=root_change_me

# --- Application ---
SERVER_PORT=8080

# Périmètre des tables surveillées (liste séparée par des virgules, sans
# espaces). Chaque table doit exister réellement dans la bd_bank.
BDBANK_SCOPE_TABLES=clients,comptes,transactions

# Clé temporaire nécessaire uniquement pour créer le premier administrateur.
# Ne jamais partager cette valeur ni la commiter.
BDBANK_SETUP_KEY=change-this-initialization-key
