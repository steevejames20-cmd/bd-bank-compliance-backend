<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.bridge</groupId>
    <artifactId>bd-bank-compliance-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>bd-bank-compliance-backend</name>
    <description>Outil de vérification de conformité des données - Bridge bd_bank</description>

    <properties>
        <java.version>25</java.version>
        <!--
            Le poste de dev utilise le JDK 25 (LTS). On aligne java.version
            dessus plutôt que de cibler artificiellement 21, et on force
            Lombok à une version avec support JDK 25 confirmé (voir
            rapports/rapport_j2.md pour le détail du bug initial).
        -->
        <lombok.version>1.18.42</lombok.version>
    </properties>

    <dependencies>
        <!-- API web (endpoints REST - semaine 4, mais dépendance posée dès l'init) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Accès JDBC générique : connexion + introspection de la bd_bank (J2-J3) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Driver MySQL (base de test locale représentant la bd_bank) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Driver PostgreSQL : ajouté dès maintenant pour la compatibilité
            multi-SGBD exigée en v1 (docs/schema-fonctionnement.md, §5),
            même si la base de test actuelle est MySQL. Le code de
            connexion (JdbcConnectionService) ne dépend d'aucun des deux
            drivers : seule la config (application.yml) choisit lequel
            est utilisé.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Validation des payloads (utile dès les DTO de règles/scope) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            ANTLR : génère le lexer/parser Java du DSL à partir de
            RuleDsl.g4 (src/main/antlr4/...). Le runtime est nécessaire au
            code généré pour s'exécuter ; le plugin (voir <build>) fait la
            génération elle-même.
        -->
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>4.13.2</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Génère RuleDslLexer/RuleDslParser/RuleDslVisitor à partir de
                RuleDsl.g4, dans target/generated-sources/antlr4 (ajouté
                automatiquement aux sources compilées, pas besoin de
                config supplémentaire). <visitor>true</visitor> est
                nécessaire : désactivé par défaut sinon.
            -->
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>4.13.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <visitor>true</visitor>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
